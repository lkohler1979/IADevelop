# =============================================================================
# MCP PostgreSQL Server — Lista de Servidores
# =============================================================================
#
# FORMATO: PG_SERVERS é uma lista de nomes separados por vírgula.
# Para cada nome, declare as variáveis PG_<NOME>_HOST, _PORT, etc.
#
# O nome é livre (sem espaços). Use algo descritivo: principal, analytics,
# homolog, producao, cliente_abc, etc.
#
# Campos disponíveis por servidor:
#   HOST     → endereço do servidor          (obrigatório)
#   PORT     → porta                         (padrão: 5432)
#   DATABASE → nome do banco                 (obrigatório)
#   USER     → usuário                       (obrigatório)
#   PASSWORD → senha                         (obrigatório)
#   SSL      → true | false                  (padrão: false)
#   POOL_MAX → máx conexões simultâneas      (padrão: 5)
#   READONLY → true = bloqueia execute/DDL   (padrão: false)
#   LABEL    → nome amigável para o Claude   (opcional)
#
# =============================================================================

# Lista de servidores ativos (separados por vírgula, sem espaços)
PG_SERVERS=ECO-LOCAL 

# -----------------------------------------------------------------------------
# Servidor: ECO-LOCAL
# -----------------------------------------------------------------------------
PG_ECO-LOCAL_HOST=192.168.21.18
PG_ECO-LOCAL_PORT=5432
PG_ECO-LOCAL_DATABASE=BDSIA50_ECO
PG_ECO-LOCAL_USER=ambion
PG_ECO-LOCAL_PASSWORD=dgVn1xR3@ambion
PG_ECO-LOCAL_SSL=false
PG_ECO-LOCAL_POOL_MAX=10
PG_ECO-LOCAL_READONLY=false
PG_ECO-LOCAL_LABEL=Ambiente de Desenvolvimento



# =============================================================================
# Para adicionar um novo servidor, basta:
#   1. Adicionar o nome em PG_SERVERS (ex: PG_SERVERS=principal,analytics,homolog,novo)
#   2. Declarar os blocos PG_NOVO_HOST, PG_NOVO_DATABASE, etc.
# =============================================================================
